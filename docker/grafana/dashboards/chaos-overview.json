{
  "title": "Chaos Platform Overview",
  "uid": "chaos-overview",
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active Experiments",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(chaos_active_experiments)",
          "legendFormat": "Active"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 3 },
            { "color": "red", "value": 10 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Experiments Started (1h)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "increase(chaos_experiments_started_total[1h])",
          "legendFormat": "Started"
        }
      ]
    },
    {
      "id": 3,
      "title": "Auto-Rollbacks (1h)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "increase(chaos_experiments_rolled_back_total[1h])",
          "legendFormat": "Rollbacks"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Kill Switch Activations",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "increase(chaos_kill_switch_engaged_total[7d])",
          "legendFormat": "Kill Switches (7d)"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Average Resilience Score",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "avg(chaos_resilience_score)",
          "legendFormat": "Score"
        }
      ],
      "options": {
        "minValue": 0,
        "maxValue": 100,
        "thresholds": {
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "green", "value": 80 }
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Experiments by Type",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum by(type) (chaos_experiments_started_total)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Experiment Duration Distribution",
      "type": "histogram",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "chaos_experiment_duration_seconds_bucket",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Policy Violations",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "increase(chaos_policy_violations_total[5m])",
          "legendFormat": "{{rule}} ({{severity}})"
        }
      ]
    },
    {
      "id": 9,
      "title": "Target System Error Rate (during chaos)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[2m])) / sum(rate(http_requests_total[2m])) * 100",
          "legendFormat": "Error Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "p99 Latency (during chaos)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[2m])) by (le)) * 1000",
          "legendFormat": "p99 Latency ms"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    }
  ]
}
