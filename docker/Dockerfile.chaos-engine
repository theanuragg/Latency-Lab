# docker/Dockerfile.chaos-engine
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat iproute2 iptables ipset stress-ng
WORKDIR /app

FROM base AS deps
COPY package.json turbo.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/chaos-engine/package.json ./packages/chaos-engine/
RUN npm install --workspaces --include-workspace-root

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY packages/shared-types ./packages/shared-types
COPY packages/chaos-engine ./packages/chaos-engine
COPY tsconfig.json ./

EXPOSE 9091
CMD ["node", "--require", "tsx/cjs", "packages/chaos-engine/src/worker.ts"]
